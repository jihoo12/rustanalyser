{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": [
        "uvx",
        "code-review-graph",
        "serve",
        "--repo",
        "/home/jihoo/codeanalyser"
      ]
    },
    "rust-analyzer-db": {
      "type": "local",
      "command": [
          "rust-analyzer-db",
          "mcp",
          "--db",
          "rust_code.db"
      ]
    }
  }
}

